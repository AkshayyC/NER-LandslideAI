{
  "provenance": {
    "title": "Terrain control points for the NER generalised elevation surface",
    "kind": "compiled_reference",
    "description": "Named places with published elevations, used to interpolate a generalised ~4.4 km elevation surface over the North Eastern Region. Point types: `summit` (peak), `pass` (mountain pass), `town` (settlement, including all district headquarters held in districts.json), `valley` (low point in a drainage or plain), `context` (a point outside NER, used only to anchor the interpolation on the far side of a border so that the escarpment and plain edges come out at the right height).",
    "accuracy": "Summits and passes carry surveyed elevations (accurate to a few metres to ~50 m). Towns carry published municipal elevations (about +/-50 m in the plains, +/-150 m in the high Himalaya). Context points are given to about +/-100 m. Coordinates are the published position where one exists; interior peaks and plateau points are placed to about +/-0.05 deg. The interpolation smooths relief: local steepness from this surface is systematically under-estimated and is therefore used as a regional *index*, never as an engineering slope angle.",
    "references": [
      "Survey of India 1:50,000 topographical sheets",
      "Published district and state gazetteers; India-WRIS elevation notes"
    ]
  },
