# NER-LandslideAI configuration.
# Copy to `.env` (or export in your shell) before running the engine.
# Every variable is optional: the system runs on the shipped reference dataset
# with no configuration at all.

# --- paths -----------------------------------------------------------------
# Where the built grid cache is written. Rebuilt on first run.
# NERLS_CACHE_DIR=./data/cache
# Where imported inventories and registered DEMs are kept.
# NERLS_USER_DATA=./data/user
# Directory of the frontend build. The API serves it from the same origin.
# NERLS_FRONTEND_DIST=./frontend/dist

# --- model -----------------------------------------------------------------
# Grid resolution in degrees. 0.04 deg is about 4.4 km.
# NERLS_GRID_RES=0.04

# --- live rainfall (Open-Meteo) --------------------------------------------
# `auto` (default) tries the live feed and falls back to the compiled station
# climatology, labelling every response with the mode that was used.
# `off` disables the attempt entirely for locked-down deployments.
# NERLS_LIVE_RAINFALL=auto
# NERLS_RAINFALL_URL=https://api.open-meteo.com/v1/forecast

# --- optional language-model briefing rewrite ------------------------------
# Without a key the briefing is the deterministic template, which always works.
# With a key the template is rewritten by an OpenAI-compatible chat completion
# endpoint. Set the model id to whatever your endpoint serves - the engine does
# not assume a particular model.
# NERLS_NARRATIVE_KEY=
# NERLS_NARRATIVE_MODEL=gpt-4o-mini
# NERLS_NARRATIVE_URL=https://api.openai.com/v1/chat/completions
